# Local environments and caches
.venv/
.cache/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
**/.ipynb_checkpoints/

# External/raw datasets are obtained according to docs/04_DATA_AND_ENVIRONMENT_GUIDE.md
data/raw/

# Generated large numerical tensors/response tables are kept with their checksums,
# summaries and reports, but are not copied into the source repository.
artifacts/**/*.parquet
artifacts/**/*.npy
artifacts/**/*.npz
artifacts/**/*.pt
artifacts/**/*.pth

# Local agent/tool state
.codex/
.agents/
.understand-anything/

# Foreign project directory (Memory Pilot): untracked 2026-09-22, then physically
# moved out of this repo to ../memory_pilot_submission/. Entry kept defensively.
submission/

# Pi agent runtime state (session-local, never commit)
.pi/

# Large intermediate JSONs (6-13MB each, 111MB total): P1 unified dumps.
# Tracked by sha in artifacts/SHA256SUMS_UNTRACKED.txt; kept local to avoid repo bloat.
artifacts/next_novelty/p1_unified/
artifacts/next_novelty/p1_unified_confirm/

# Collected GPU result archives stay local. GitHub rejects files over 100MB;
# these three are 251MB, 876MB and 2.0GB. Extracted JSON/CSV evidence is tracked.
artifacts/e1a933_review/**/*.tar.gz
artifacts/e1a933_review/**/*.tar

# GPU repair transport archives; extracted evidence and SHA256 receipts are kept.
artifacts/submission_audit_20260925/**/*.tar.gz

# LaTeX build artifacts (regenerable via pdflatex+bibtex in paper/)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.pdf
!paper/figures/*.pdf

# Final submission PDFs and vector figures are deliverables, not build cache.
!deliverables/iclr2027_final_20260925/main.pdf
!deliverables/iclr2027_final_20260925/supplementary.pdf
!deliverables/iclr2027_final_20260925/figures/*.pdf
